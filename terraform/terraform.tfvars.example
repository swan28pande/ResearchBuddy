# Example terraform.tfvars file
# Copy this to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git (it's in .gitignore)

# AWS Configuration
aws_region  = "us-east-1"
environment = "prod"

# Instance Configuration
instance_type     = "t3.medium"
min_instances     = 2
max_instances     = 4
desired_instances = 2

# Security
admin_ip = "YOUR_IP_ADDRESS/32" # Replace with your IP for SSH access

# API Keys (alternatively, set these via environment variables or GitHub Secrets)
# openai_api_key            = "sk-..."
# tavily_api_key           = "tvly-..."
# semantic_scholar_api_key = "..."

# Optional: Specify existing EC2 key pair name
# key_pair_name = "my-key-pair"
